{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaduxai.id/schemas/content-strategist/strategy-output.schema.json",
  "title": "LeadUX Content Strategy Output",
  "type": "object",
  "required": [
    "strategy_id",
    "strategy_version",
    "created_at",
    "research_package_id",
    "primary_objective",
    "strategic_wedge",
    "content_pillars",
    "content_opportunities",
    "portfolio",
    "challenger_findings",
    "integrity_status",
    "strategy_diagnosis_id",
    "strategy_formulation_id",
    "strategy_validation_id",
    "selected_strategic_thesis_id",
    "strategic_options",
    "explicit_tradeoffs",
    "reversal_triggers"
  ],
  "properties": {
    "strategy_id": {
      "type": "string"
    },
    "strategy_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "research_package_id": {
      "type": "string"
    },
    "identity_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "business_context_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "audience_icp_fit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "customer_journey_intent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "positioning_offer_fit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "channel_distribution_fit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "founder_context_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "founder_context_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_pattern_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejected_pattern_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "journey_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "channel_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "distribution_plan": {
      "type": "object",
      "additionalProperties": true
    },
    "primary_objective": {
      "type": "object",
      "additionalProperties": true
    },
    "strategic_wedge": {
      "type": "object",
      "additionalProperties": true
    },
    "content_pillars": {
      "type": "array",
      "items": {
        "$ref": "content-pillar.schema.json"
      }
    },
    "content_opportunities": {
      "type": "array",
      "items": {
        "$ref": "content-opportunity.schema.json"
      }
    },
    "portfolio": {
      "type": "object",
      "properties": {
        "core": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "responsive": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "experiment": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "experiments": {
      "type": "array",
      "items": {
        "$ref": "experiment.schema.json"
      }
    },
    "creator_briefs": {
      "type": "array",
      "items": {
        "$ref": "content-brief.schema.json"
      }
    },
    "challenger_findings": {
      "type": "array",
      "items": {
        "$ref": "challenger-result.schema.json"
      }
    },
    "research_requests": {
      "type": "array",
      "items": {
        "$ref": "research-request.schema.json"
      }
    },
    "measurement_plan": {
      "type": "object",
      "additionalProperties": true
    },
    "integrity_status": {
      "enum": [
        "READY",
        "READY_WITH_GAPS",
        "NEEDS_RESEARCH",
        "BLOCKED"
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "strategy-decision.schema.json"
      }
    },
    "strategy_diagnosis_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy_formulation_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy_validation_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_strategic_thesis_id": {
      "type": "string",
      "minLength": 1
    },
    "strongest_alternative_thesis_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "strategic_options": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "strategic-thesis.schema.json"
      }
    },
    "explicit_tradeoffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reversal_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "strategy_validation": {
      "$ref": "strategy-validation.schema.json"
    }
  },
  "additionalProperties": true
}