{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaduxai.id/schemas/content-strategist/content-brief.schema.json",
  "title": "LeadUX Creator Brief",
  "type": "object",
  "required": ["brief_id","content_opportunity_id","objective","audience","angle","required_evidence_ids","forbidden_claims","success_metric"],
  "properties": {
    "brief_id": {"type":"string"},
    "content_opportunity_id": {"type":"string"},
    "decision_id": {"type":["string","null"]},
    "pillar_id": {"type":["string","null"]},
    "objective": {"type":"string"},
    "audience": {"type":"string"},
    "audience_role": {"type":["string","null"]},
    "journey_state": {"type":["string","null"]},
    "next_decision": {"type":["string","null"]},
    "content_job": {"type":["string","null"]},
    "topic": {"type":["string","null"]},
    "tension": {"type":["string","null"]},
    "angle": {"type":"string"},
    "required_evidence_ids": {"type":"array","items":{"type":"string"}},
    "required_facts": {"type":"array","items":{"type":"string"}},
    "forbidden_claims": {"type":"array","items":{"type":"string"}},
    "channel_fit_id": {"type":["string","null"]},
    "channel_id": {"type":["string","null"]},
    "channel_role": {"type":["string","null"]},
    "channel_family": {"type":["string","null"]},
    "recommended_format": {"type":["string","null"]},
    "format_adaptation_notes": {"type":"array","items":{"type":"string"}},
    "channel": {"type":["string","null"]},
    "cta_intent": {"type":["string","null"]},
    "cta_strength": {"type":["string","null"]},
    "desired_next_action": {"type":["string","null"]},
    "success_metric": {"type":"string"},
    "metric_level": {"enum":["DISTRIBUTION_SIGNAL","AUDIENCE_RESPONSE","LEAD_SIGNAL","BUSINESS_OUTCOME","UNKNOWN"]},
    "constraints": {"type":"array","items":{"type":"string"}},
    "experiment_id": {"type":["string","null"]}
  },
  "additionalProperties": true
}
