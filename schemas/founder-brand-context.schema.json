{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leaduxai.id/schemas/content-strategist/founder-brand-context.schema.json",
  "title": "LeadUX Founder / Brand Context",
  "type": "object",
  "required": ["context_id", "identity", "business", "positioning", "audiences", "offers", "content_identity", "constraints"],
  "properties": {
    "context_id": {"type": "string", "minLength": 1},
    "version": {"type": ["string", "null"]},
    "updated_at": {"type": ["string", "null"]},
    "identity": {
      "type": "object",
      "required": ["name", "role"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "public_identity": {"type": ["string", "null"]},
        "expertise": {"type": "array", "items": {"type": "string"}},
        "credible_experience": {"type": "array", "items": {"type": "string"}},
        "point_of_view": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "business": {
      "type": "object",
      "required": ["name", "business_model"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "business_model": {"type": "array", "items": {"type": "string"}},
        "commercial_priority": {"type": "array", "items": {"type": "string"}},
        "current_stage": {"type": ["string", "null"]},
        "geographies": {"type": "array", "items": {"type": "string"}},
        "languages": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "positioning": {
      "type": "object",
      "required": ["core_promise"],
      "properties": {
        "core_promise": {"type": "string", "minLength": 1},
        "category": {"type": ["string", "null"]},
        "differentiators": {"type": "array", "items": {"type": "string"}},
        "proof_assets": {"type": "array", "items": {"type": "string"}},
        "anti_positioning": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["audience_id", "name", "priority"],
        "properties": {
          "audience_id": {"type": "string"},
          "name": {"type": "string"},
          "priority": {"enum": ["PRIMARY", "SECONDARY", "EXPERIMENTAL"]},
          "buyer_roles": {"type": "array", "items": {"type": "string"}},
          "jobs": {"type": "array", "items": {"type": "string"}},
          "problems": {"type": "array", "items": {"type": "string"}},
          "desired_outcomes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["offer_id", "name", "priority"],
        "properties": {
          "offer_id": {"type": "string"},
          "name": {"type": "string"},
          "priority": {"enum": ["CORE", "GROWTH", "EXPERIMENT", "DEPRIORITIZED"]},
          "target_audience_ids": {"type": "array", "items": {"type": "string"}},
          "outcome": {"type": ["string", "null"]},
          "proof_assets": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "content_identity": {
      "type": "object",
      "required": ["content_jobs", "voice", "preferred_evidence"],
      "properties": {
        "content_jobs": {"type": "array", "items": {"type": "string"}},
        "voice": {"type": "array", "items": {"type": "string"}},
        "preferred_evidence": {"type": "array", "items": {"type": "string"}},
        "strong_formats": {"type": "array", "items": {"type": "string"}},
        "weak_or_expensive_formats": {"type": "array", "items": {"type": "string"}},
        "signature_topics": {"type": "array", "items": {"type": "string"}},
        "avoid_topics": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel", "role"],
        "properties": {
          "channel": {"type": "string"},
          "role": {"type": "string"},
          "priority": {"enum": ["PRIMARY", "SECONDARY", "REPURPOSE_ONLY", "EXPERIMENTAL"]},
          "audience_ids": {"type": "array", "items": {"type": "string"}},
          "constraints": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "constraints": {
      "type": "object",
      "required": ["must_do", "must_not_do"],
      "properties": {
        "must_do": {"type": "array", "items": {"type": "string"}},
        "must_not_do": {"type": "array", "items": {"type": "string"}},
        "capacity": {"type": "object", "additionalProperties": true},
        "legal_or_market": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
